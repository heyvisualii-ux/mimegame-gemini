# Copy this file to android/keystore.properties and fill in your credentials to build a signed Release APK or AAB.
# NEVER commit android/keystore.properties or any *.keystore / *.jks file to source control.
# storeFile is resolved relative to the android/ directory (or android/app/ or an absolute path).
storeFile=pantomix-release.keystore
storePassword=CHANGE_ME
keyAlias=pantomix
keyPassword=CHANGE_ME
