# ==============================================================================
# Server-Side Secrets (NEVER prefix with NEXT_PUBLIC_ — keep in cPanel Node.js env vars or .env)
# ==============================================================================
GEMINI_API_KEY=

# Node runtime mode (set to production on cPanel)
NODE_ENV=production

# ==============================================================================
# Optional / Build-Time Configuration
# ==============================================================================
# Leave empty in production when web & /api/ai/* share the same origin (https://game.dresmaeiliclinic.ir)
# NEXT_PUBLIC_API_BASE_URL=

# Configurable production server origin for Capacitor Android WebView (used during `npx cap sync android`)
CAPACITOR_SERVER_URL=https://game.dresmaeiliclinic.ir/
